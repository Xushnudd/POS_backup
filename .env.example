# Development only. Replace passwords in your private .env; never commit it.
POSTGRES_USER=pos_user
POSTGRES_DB=pos_db
POSTGRES_PASSWORD=
# Compose app/migrate use the internal hostname db. URL-encode password characters.
DATABASE_URL=
# Production: your actual public HTTPS origin, without path/query/fragment.
APP_ORIGIN=
POS_BIND_ADDRESS=127.0.0.1
POS_PORT=3000
# Set a immutable image tag per release.
POS_IMAGE=pos-app:local
# TRUST_PROXY_IP=true only when the trusted reverse proxy overwrites client IP headers.
