# Development only. Replace passwords in your private .env; never commit it.
POSTGRES_USER=pos_user
POSTGRES_DB=pos_db
POSTGRES_PASSWORD=
# Compose app/migrate use the internal hostname db. URL-encode password characters.
DATABASE_URL=
# Production: your actual public HTTPS origin, without path/query/fragment.
APP_ORIGIN=
POS_BIND_ADDRESS=127.0.0.1
POS_PORT=3000
# Set a immutable image tag per release.
POS_IMAGE=pos-app:local
# TRUST_PROXY_IP=true only when the trusted reverse proxy overwrites client IP headers.
# Optional until an approved real SMS/e-mail authentication binding is configured.
# Separate private 32-byte random key, represented by 64 hexadecimal characters.
# Used for OTP HMAC and HKDF-separated AES-GCM delivery; never commit its value.
AUTH_TOTP_ENABLED=false
# Enable only after owner/platform enrollment and critical-action UI acceptance.
# Unlike availability, this policy stays enforced during a TOTP key outage.
AUTH_CRITICAL_MFA_REQUIRED=false
AUTH_CHALLENGE_SECRET=
# Optional rotation overlap: at most two retired 64-hex keys, comma-separated.
# Secret-manager configuration only; remove after controlled re-encryption.
AUTH_TOTP_PREVIOUS_SECRETS=
API_READS_PER_MINUTE=600
API_WRITES_PER_MINUTE=300
API_PUBLIC_WRITES_PER_MINUTE=1200
API_BODY_TIMEOUT_MS=10000
