# TEMPLATE ONLY. Copy outside the repository to an operator-owned 0600 file.
# Never use the same database, password, key or volume for another environment.
COMPOSE_PROJECT_NAME=pos-production
POSTGRES_DB=pos_production
POSTGRES_USER=pos_production
POSTGRES_PASSWORD=
# URL-encode password; internal service hostname is db, database is pos_production.
DATABASE_URL=
# Actual operator-approved HTTPS origin, no assumed domain.
APP_ORIGIN=
# Immutable image digest and release identifier, both supplied by operator.
POS_IMAGE=
POS_RELEASE=
POS_BIND_ADDRESS=127.0.0.1
POS_PORT=3000
AUTH_TOTP_ENABLED=true
AUTH_CRITICAL_MFA_REQUIRED=true
AUTH_CHALLENGE_SECRET=
AUTH_TOTP_PREVIOUS_SECRETS=
# Enable only behind the approved proxy which overwrites client IP headers.
TRUST_PROXY_IP=
POS_STATE_DIRECTORY=
