// Prisma schema for Shuni POS
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Organization and Auth
model Organization {
 providerIntents ProviderIntent[]
 receiptCostPlans ReceiptCostPlan[]
 customerAdvances CustomerAdvance[]
  securityEvents SecurityEvent[]
  backgroundJobs BackgroundJob[]
  jobAuthorizations JobAuthorization[]
  exchanges SaleExchange[]
  onboardingCheckpoints OnboardingCheckpoint[]
  priceRules         PriceRule[]
  customerGroups     CustomerGroup[]
  supportGrants      SupportGrant[]
  taxProfiles TaxProfile[]
  brands Brand[]
  files FileAsset[]
  purchaseOrders PurchaseOrder[]
  supplierInvoices SupplierInvoice[]
  supplierPayments SupplierPayment[]
  financialAccounts FinancialAccount[]
  expenseCategories ExpenseCategory[]
  financialDocuments FinancialDocument[]
  accountEntries AccountEntry[]
  id               String   @id @default(uuid())
  name             String
  tin              String?  @unique
  phone            String
  currencyCode     String   @default("UZS")
  timezone         String   @default("Asia/Tashkent")
  allowNegativeStock Boolean @default(false)
  receiptFooter    String?
  createdAt        DateTime @default(now())
  
  priceHistory     ProductPriceHistory[]
  damageLocations DamageLocation[]
  dispositions ReturnDispositionEntry[]
  stockCounts      StockCount[]
  units            Unit[]
  productBarcodes  ProductBarcode[]
  invitations      Invitation[]
  operations       Operation[]
  debtEntries      DebtEntry[]
  sessions         Session[]
  users            OrganizationUser[]
  stores           Store[]
  categories       Category[]
  products         Product[]
  customers        Customer[]
  suppliers        Supplier[]
  stockDocuments   StockDocument[]
  stockTransfers   StockTransfer[]
  sales            Sale[]
  payments         Payment[]
  discountPolicies DiscountPolicy[]
  auditLogs        AuditLog[]
  ownershipTransfers OwnershipTransfer[]
  shiftCorrections ShiftCorrection[]
  incidents Incident[]
  syncReviews SyncReview[]
  stockThresholds StockThreshold[]
}

model User {
 providerIntents ProviderIntent[]
 createdReceiptCostPlans ReceiptCostPlan[] @relation("ReceiptCostCreator")
 cancelledReceiptCostPlans ReceiptCostPlan[] @relation("ReceiptCostCanceller")
  securityEvents SecurityEvent[]
  jobAuthorizations JobAuthorization[]
  exchanges SaleExchange[]
  onboardingCheckpoints OnboardingCheckpoint[]
  platformOperator      PlatformOperator?
  approvedSupportGrants SupportGrant[]      @relation("SupportApprover")
  financialDocuments FinancialDocument[]
  resolvedIncidents Incident[]
  syncSources SyncReview[] @relation("SyncActor")
  resolvedSyncReviews SyncReview[] @relation("SyncResolver")
  assignedSales Sale[] @relation("SaleSeller")
  id             String   @id @default(uuid())
  fullName       String
  phone          String   @unique
  email          String?  @unique
  passwordHash   String
  isActive       Boolean  @default(true)
  lastLoginAt    DateTime?
  createdAt      DateTime @default(now())
  
  invitations    Invitation[]
  sessions       Session[]
  organizationUsers OrganizationUser[]
  createdStockDocuments    StockDocument[] @relation("CreatedBy")
  confirmedStockDocuments  StockDocument[] @relation("ConfirmedBy")
  createdStockTransfers    StockTransfer[] @relation("CreatedBy")
  cashMovements           CashMovement[]
  sales                   Sale[] @relation("Cashier")
  voidedSales             Sale[] @relation("VoidedBy")
  payments                Payment[] @relation("ReceivedBy")
  saleReturns             SaleReturn[] @relation("ProcessedBy")
  dispositionEntries ReturnDispositionEntry[] @relation("DispositionActor")
  auditLogs               AuditLog[]
  inventoryMovements      InventoryMovement[] @relation("InventoryMovementCreator")
  shiftCorrections        ShiftCorrection[]
}

model OrganizationUser {
  pinHash String?
  id             String   @id @default(uuid())
  organizationId String
  userId         String
  role           String   // owner, admin, cashier
  isActive       Boolean  @default(true)
  archivedAt     DateTime?
  createdAt      DateTime @default(now())
  
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userStores     UserStore[]
  shifts         Shift[]
  
  @@unique([organizationId, userId])
}

model Store {
 providerIntents ProviderIntent[]
 receiptCostPlans ReceiptCostPlan[]
  exchanges SaleExchange[]
  onboardingCheckpoints OnboardingCheckpoint[]
  purchaseOrders PurchaseOrder[]
  supplierInvoices SupplierInvoice[]
  supplierPayments SupplierPayment[]
  financialAccounts FinancialAccount[]
  financialDocuments FinancialDocument[]
  damageLocations DamageLocation[]
  incidents Incident[]
  stockThresholds StockThreshold[]
  id             String   @id @default(uuid())
  organizationId String
  name           String
  address        String?
  phone          String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userStores     UserStore[]
  registers      Register[]
  stockCounts    StockCount[]
  stockFreezes   StockFreeze[]
  stockDocuments StockDocument[]
  inventoryBalances InventoryBalance[]
  inventoryMovements InventoryMovement[]
  fromStockTransfers StockTransfer[] @relation("FromStore")
  toStockTransfers   StockTransfer[] @relation("ToStore")
  sales          Sale[]
  payments       Payment[]
  dispositionEntries ReturnDispositionEntry[]
}

model UserStore {
  organizationUserId String
  storeId            String
  
  organizationUser   OrganizationUser @relation(fields: [organizationUserId], references: [id], onDelete: Cascade)
  store              Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  
  @@unique([organizationUserId, storeId])
}

model ReceiptCostPlan {
 id String @id @default(uuid())
 organizationId String
 storeId String
 stockDocumentId String
 expenseDocumentId String
 amount Decimal @db.Decimal(14,2)
 method String
 status String @default("prepared")
 snapshot Json
 reason String
 createdBy String
 createdAt DateTime @default(now())
 cancelledBy String?
 cancelledAt DateTime?
 cancellationReason String?
 organization Organization @relation(fields:[organizationId],references:[id],onDelete:Cascade,onUpdate:NoAction)
 store Store @relation(fields:[storeId],references:[id],onDelete:NoAction,onUpdate:NoAction)
 stockDocument StockDocument @relation(fields:[stockDocumentId],references:[id],onDelete:NoAction,onUpdate:NoAction)
 expenseDocument FinancialDocument @relation(fields:[expenseDocumentId],references:[id],onDelete:NoAction,onUpdate:NoAction)
 creator User @relation("ReceiptCostCreator",fields:[createdBy],references:[id],onDelete:NoAction,onUpdate:NoAction)
 canceller User? @relation("ReceiptCostCanceller",fields:[cancelledBy],references:[id],onDelete:NoAction,onUpdate:NoAction)

 @@index([organizationId,storeId,stockDocumentId,createdAt,id])
 // Active expense uniqueness is a partial index in migration096.
}

model Register {
  financialAccount FinancialAccount?
  receiptSequence Decimal @default(0) @db.Decimal(20, 0)
  id        String   @id @default(uuid())
  storeId   String
  name      String
  code      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  
  store     Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  shifts    Shift[]
  sales     Sale[]
  
  @@unique([storeId, code])
}

// Catalog
model Category {
  parentId String?
  parent Category? @relation("CategoryTree",fields:[parentId],references:[id],onDelete:NoAction)
  children Category[] @relation("CategoryTree")
  id             String   @id @default(uuid())
  organizationId String
  name           String
  sortOrder      Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  products       Product[]
  
  @@unique([organizationId, name])
}

model Product {
  unitConversions ProductUnitConversion[]
  mxik String?
  mxikSource String?
  mxikRequired Boolean @default(false)
  taxRequired Boolean @default(false)
  markingRequired Boolean @default(false)
  priceRules         PriceRule[]
  taxProfileId String?
  taxProfile TaxProfile? @relation(fields:[taxProfileId],references:[id],onDelete:NoAction)
  brandId String?
  brand Brand? @relation(fields:[brandId],references:[id],onDelete:NoAction)
  description String @default("")
  files FileAsset[]
  variant ProductVariant? @relation("VariantStock")
  variants ProductVariant[] @relation("VariantRoot")
  purchaseOrderItems PurchaseOrderItem[]
  priceHistory ProductPriceHistory[]
  stockThresholds StockThreshold[]
  id             String   @id @default(uuid())
  organizationId String
  categoryId     String?
  name           String
  sku            String
  barcode        String
  unit           String   // dona, kg, litr, etc.
  salePrice      Decimal  @db.Decimal(14, 2)
  costPrice      Decimal  @db.Decimal(20, 6)
  minStock           Decimal               @default(0) @db.Decimal(20, 6)
  imageUrl       String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category       Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  countLines     StockCountLine[]
  stockFreezes   StockFreeze[]
  barcodes       ProductBarcode[]
  stockDocumentItems StockDocumentItem[]
  stockTransferItems   StockTransferItem[]
  inventoryMovements   InventoryMovement[]
  inventoryBalances    InventoryBalance[]
  saleItems             SaleItem[]
  saleReturnItems       SaleReturnItem[]
  dispositionEntries ReturnDispositionEntry[]

  @@unique([id,organizationId])
  @@unique([organizationId, sku])
  @@unique([organizationId, barcode])
}

model Customer {
 advances CustomerAdvance[]
  canonicalPhone String?
  mergedIntoId String?
  groupId        String?
  group          CustomerGroup? @relation(fields: [groupId], references: [id], onDelete: NoAction)
  priceRules     PriceRule[]
  id             String   @id @default(uuid())
  organizationId String
  fullName       String
  phone          String
  address        String?
  note           String?
  creditLimit    Decimal        @default(0) @db.Decimal(14, 2)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sales          Sale[]
  payments       Payment[]
  debtEntries    DebtEntry[]
  
  @@index([phone])
}

model Supplier {
  purchaseOrders PurchaseOrder[]
  supplierInvoices SupplierInvoice[]
  supplierPayments SupplierPayment[]
  id             String   @id @default(uuid())
  organizationId String
  name           String
  phone          String?
  tin            String?
  address        String?
  note           String?
  bankName       String?
  bankAccount    String?
  paymentTerms   String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stockDocuments StockDocument[]
}

// Inventory
model StockDocument {
 receiptCostPlans ReceiptCostPlan[]
  purchaseReceipt PurchaseReceipt?
  supplierInvoice SupplierInvoice?
  id             String   @id @default(uuid())
  organizationId String
  storeId        String
  supplierId     String?
  documentType   String   // purchase, adjustment, transfer_out, transfer_in, return_in
  documentNo     String
  reversalOfId   String? @unique
  reversalOf     StockDocument? @relation("DocumentReversal", fields: [reversalOfId], references: [id], onDelete: NoAction)
  reversal       StockDocument? @relation("DocumentReversal")
  status         String   @default("draft") // draft, confirmed
  note           String?
  createdBy      String
  confirmedBy    String?
  confirmedAt    DateTime?
  createdAt      DateTime @default(now())
  
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  store          Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  supplier       Supplier?    @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  creator        User         @relation("CreatedBy", fields: [createdBy], references: [id])
  confirmer      User?        @relation("ConfirmedBy", fields: [confirmedBy], references: [id])
  stockCount     StockCount?
  items          StockDocumentItem[]
}

model StockDocumentItem {
  conversionSnapshot Json?
 supplierCreditItems SupplierCreditItem[]
  purchaseReceiptLine PurchaseReceiptLine?
  id              String   @id @default(uuid())
  stockDocumentId String
  productId       String
  quantity        Decimal  @db.Decimal(20, 6)
  unitCost        Decimal  @db.Decimal(20, 6)
  note            String?
  createdAt       DateTime @default(now())
  
  stockDocument   StockDocument @relation(fields: [stockDocumentId], references: [id], onDelete: Cascade)
  product         Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model InventoryMovement {
  id             String   @id @default(uuid())
  organizationId String
  storeId        String
  productId      String
  movementType   String   // sale, return, stock_document
  quantityDelta  Decimal  @db.Decimal(20, 6)
  unitCost       Decimal  @db.Decimal(20, 6)
  sourceType     String   // sale, return, stock_document
  sourceId       String
  occurredAt     DateTime @default(now())
  createdBy      String
  note           String?
  
  store          Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product        Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  creator        User         @relation("InventoryMovementCreator", fields: [createdBy], references: [id])
}

model InventoryBalance {
  storeId   String
  productId String
  quantity  Decimal  @default(0) @db.Decimal(20, 6)
  updatedAt DateTime @updatedAt
  
  store    Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product  Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  @@id([storeId, productId])
  @@index([productId])
}

model StockTransfer {
  id             String   @id @default(uuid())
  organizationId String
  fromStoreId    String
  toStoreId      String
  status         String   @default("draft") // draft, sent, received
  note           String?
  createdBy      String
  sentAt         DateTime?
  receivedAt     DateTime?
  createdAt      DateTime @default(now())
  
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fromStore      Store        @relation("FromStore", fields: [fromStoreId], references: [id], onDelete: Cascade)
  toStore        Store        @relation("ToStore", fields: [toStoreId], references: [id], onDelete: Cascade)
  creator        User         @relation("CreatedBy", fields: [createdBy], references: [id])
  items          StockTransferItem[]
}

model StockTransferItem {
  id              String   @id @default(uuid())
  stockTransferId String
  productId       String
  receivedQuantity Decimal @default(0) @db.Decimal(20, 6)
  returnedQuantity Decimal @default(0) @db.Decimal(20, 6)
  damagedQuantity  Decimal @default(0) @db.Decimal(20, 6)
  shortageQuantity Decimal @default(0) @db.Decimal(20, 6)
  quantity        Decimal  @db.Decimal(20, 6)
  unitCost        Decimal  @db.Decimal(20, 6)
  
  stockTransfer   StockTransfer @relation(fields: [stockTransferId], references: [id], onDelete: Cascade)
  product         Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  dispositions  TransferDispositionEntry[]
}

model TransferDispositionEntry {
  id             String            @id @default(uuid())
  organizationId String
  storeId        String
  productId      String
  itemId         String
  operationId    String
  disposition    String
  quantity       Decimal           @db.Decimal(20, 6)
  unitCost       Decimal           @db.Decimal(20, 6)
  productName    String
  sku            String
  unit           String
  reason         String
  actorId        String
  createdAt      DateTime          @default(now())
  item           StockTransferItem @relation(fields: [itemId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([itemId, operationId, disposition])
  @@index([organizationId, storeId, createdAt, id])
}

model PlatformOperator {
  userId    String         @id
  role      String
  isActive  Boolean        @default(true)
  createdAt DateTime       @default(now())
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  grants    SupportGrant[]
}

model SupportGrant {
  id             String           @id @default(uuid())
  organizationId String
  operatorUserId String
  approvedBy     String
  reason         String
  scopes         String[]
  storeIds       String[]
  createdAt      DateTime         @default(now())
  expiresAt      DateTime
  revokedAt      DateTime?
  revokedBy      String?
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  operator       PlatformOperator @relation(fields: [operatorUserId], references: [userId], onDelete: NoAction, onUpdate: NoAction)
  approver       User             @relation("SupportApprover", fields: [approvedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([organizationId, createdAt, id])
  @@index([operatorUserId, expiresAt])
}

// Sales and POS
model Shift {
  pendingClose Json?
  countedBy String?
  approvedBy String?
  closeReason String?
  handoverFromId String? @unique
  id               String   @id @default(uuid())
  registerId       String
  organizationUserId String
  openedAt         DateTime @default(now())
  openingCash      Decimal  @db.Decimal(14, 2)
  closedAt         DateTime?
  expectedCash     Decimal? @db.Decimal(14, 2)
  countedCash      Decimal? @db.Decimal(14, 2)
  cashDifference   Decimal? @db.Decimal(14, 2)
  status           String   @default("open") // open, closed
  note             String?
  
  register         Register         @relation(fields: [registerId], references: [id], onDelete: Cascade)
  organizationUser OrganizationUser @relation(fields: [organizationUserId], references: [id], onDelete: Cascade)
  cashMovements    CashMovement[]
  sales            Sale[]
  payments         Payment[]
  corrections      ShiftCorrection[] @relation("OriginalShift")
  postedCorrections ShiftCorrection[] @relation("PostingShift")
  
  @@index([organizationUserId])
}

model CashMovement {
  accountEntry AccountEntry?
  id           String   @id @default(uuid())
  shiftId      String
  movementType String   // cash_in, cash_out
  amount       Decimal  @db.Decimal(14, 2)
  reason       String
  createdBy    String
  createdAt    DateTime @default(now())
  
  shift        Shift @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  creator      User  @relation(fields: [createdBy], references: [id])
  correction   ShiftCorrection?
}

model ShiftCorrection {
  id               String @id @default(uuid())
  organizationId   String
  originalShiftId  String
  postingShiftId   String
  cashMovementId   String @unique
  amount           Decimal @db.Decimal(14, 2)
  reason           String
  createdBy        String
  createdAt        DateTime @default(now())
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  originalShift    Shift @relation("OriginalShift", fields: [originalShiftId], references: [id], onDelete: Cascade)
  postingShift     Shift @relation("PostingShift", fields: [postingShiftId], references: [id], onDelete: Cascade)
  cashMovement     CashMovement @relation(fields: [cashMovementId], references: [id], onDelete: Cascade)
  creator          User @relation(fields: [createdBy], references: [id])

  @@index([organizationId, originalShiftId, createdAt])
}

model Sale {
  originalExchanges SaleExchange[] @relation("ExchangeOriginal")
  replacementExchange SaleExchange? @relation("ExchangeReplacement")
  discountPercent Decimal? @db.Decimal(5,2)
  discountReason String?
  discountApprovedBy String?
  discountApprovedRole String?
  discountApprovedAt DateTime?
  discountPolicySnapshot Json?
  taxAmount Decimal @default(0) @db.Decimal(14,2)
  netAmount Decimal? @db.Decimal(14,2)
  fiscalReceiptNo String?
  id             String   @id @default(uuid())
  organizationId String
  storeId        String
  registerId     String
  shiftId        String
  cashierId      String
  customerId     String?
  receiptNo      String
  status         String   @default("draft") // draft, completed, voided, partially_returned, returned
  subtotal       Decimal  @db.Decimal(14, 2)
  discountAmount         Decimal   @default(0) @db.Decimal(14, 2)
  totalAmount    Decimal  @db.Decimal(14, 2)
  cashTendered   Decimal? @db.Decimal(14, 2)
  cashChange     Decimal? @db.Decimal(14, 2)
  sellerId       String?
  serviceType    String?
  seller         User? @relation("SaleSeller", fields: [sellerId], references: [id])
  note           String?
  completedAt    DateTime?
  voidedAt       DateTime?
  voidedBy       String?
  createdAt      DateTime @default(now())
  
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  store          Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  register       Register     @relation(fields: [registerId], references: [id], onDelete: Cascade)
  shift          Shift        @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  cashier        User         @relation("Cashier", fields: [cashierId], references: [id])
  customer       Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  voider         User?        @relation("VoidedBy", fields: [voidedBy], references: [id])
  items          SaleItem[]
  payments       Payment[]
  saleReturns    SaleReturn[]
  
  @@unique([registerId, receiptNo])
  @@index([customerId,completedAt])
}

model SaleItem {
  conversionSnapshot Json?
  complianceSnapshot Json?
  priceRuleId     String?
  priceRule       PriceRule?         @relation(fields: [priceRuleId], references: [id], onDelete: NoAction)
  priceSnapshot   Json?
  discountPercent Decimal? @db.Decimal(5,2)
  taxVersionId String?
  taxVersion TaxProfileVersion? @relation(fields:[taxVersionId],references:[id],onDelete:NoAction)
  taxMode String @default("unconfigured")
  taxRate Decimal @default(0) @db.Decimal(5,2)
  taxBase Decimal? @db.Decimal(14,2)
  taxAmount Decimal @default(0) @db.Decimal(14,2)
  payableAmount Decimal? @db.Decimal(14,2)
  roundingVersion String @default("legacy-unspecified")
  id             String   @id @default(uuid())
  saleId         String
  productId      String
  productName    String
  sku            String
  unit           String?  // Legacy receipts did not snapshot a unit.
  quantity       Decimal  @db.Decimal(20, 6)
  unitPrice      Decimal  @db.Decimal(14, 2)
  discountAmount  Decimal            @default(0) @db.Decimal(14, 2)
  lineTotal      Decimal  @db.Decimal(14, 2)
  unitCost       Decimal  @db.Decimal(20, 6)
  receiptDiscount Decimal            @default(0) @db.Decimal(14, 2)
  createdAt      DateTime @default(now())
  
  sale           Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product        Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  saleReturnItems SaleReturnItem[]
  @@index([saleId,productId])
  @@index([productId])
  @@index([priceRuleId])
}

model Payment {
  sourceType     String @default("manual") // manual journal versus a future trusted provider posting
  id             String   @id @default(uuid())
  organizationId String
  storeId        String
  shiftId        String?
  saleId         String?
  customerId     String?
  paymentType    String   // cash, card, transfer, credit
  status         String   @default("recorded") // manual/cash record, never an implied provider confirmation
  direction      String   // in, out
  amount         Decimal  @db.Decimal(14, 2)
  referenceNo    String?
  paidAt         DateTime @default(now())
  receivedBy     String
  note           String?
  createdAt      DateTime @default(now())
  
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  store          Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  shift          Shift?       @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  sale           Sale?        @relation(fields: [saleId], references: [id], onDelete: Cascade)
  customer       Customer?    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  receiver       User         @relation("ReceivedBy", fields: [receivedBy], references: [id])
  @@index([saleId])
  @@index([shiftId,paymentType,status])
}

model SaleReturn {
  exchange SaleExchange?
  id              String   @id @default(uuid())
  saleId          String
  returnReceiptNo String
  status          String   @default("completed") // completed
  refundAmount    Decimal  @db.Decimal(14, 2)
  reason          String?
  processedBy     String
  returnedAt      DateTime @default(now())
  createdAt       DateTime @default(now())
  approvedBy      String?
  approvedRole    String?
  approvedAt      DateTime?
  
  sale            Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  processor       User     @relation("ProcessedBy", fields: [processedBy], references: [id])
  items           SaleReturnItem[]
  @@index([saleId,returnedAt])
}

model SaleReturnItem {
  taxAmount Decimal @default(0) @db.Decimal(14,2)
  taxBase Decimal? @db.Decimal(14,2)
  discountAmount Decimal @default(0) @db.Decimal(14,2)
  id              String   @id @default(uuid())
  saleReturnId    String
  saleItemId      String
  productId       String
  quantity        Decimal  @db.Decimal(20, 6)
  unitPrice       Decimal  @db.Decimal(14, 2)
  lineTotal       Decimal  @db.Decimal(14, 2)
  disposition     String @default("sellable") // sellable, damaged, write_off
  
  saleReturn      SaleReturn @relation(fields: [saleReturnId], references: [id], onDelete: Cascade)
  saleItem        SaleItem   @relation(fields: [saleItemId], references: [id], onDelete: Cascade)
  product         Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
