// Account-only security history. No credentials or raw client metadata enter these tables.
model SecurityEvent {
  id String @id @default(uuid())
  organizationId String
  userId String
  type String
  suspicious Boolean @default(false)
  sourceSessionId String?
  sourceAuditLogId String? @unique
  clientHash String?
  createdAt DateTime @default(now())
  expiresAt DateTime
  organization Organization @relation(fields:[organizationId],references:[id],onDelete:Cascade)
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  outbox SecurityNoticeOutbox?
  notice SecurityNotice?
  @@index([userId,createdAt(sort:Desc),id])
  @@index([expiresAt])
}
model SecurityNoticeOutbox {
  id String @id @default(uuid())
  eventId String @unique
  state String @default("pending")
  dedupeKey String @unique
  attempts Int @default(0)
  maxAttempts Int @default(3)
  nextRunAt DateTime @default(now())
  lastError String?
  createdAt DateTime @default(now())
  deliveredAt DateTime?
  event SecurityEvent @relation(fields:[eventId],references:[id],onDelete:Cascade)
  @@index([state,nextRunAt])
}
model SecurityNotice {
  id String @id @default(uuid())
  eventId String @unique
  createdAt DateTime @default(now())
  readAt DateTime?
  event SecurityEvent @relation(fields:[eventId],references:[id],onDelete:Cascade)
}


