// Immutable cash advance journals; migration094 also enforces exact source and budget.
model CustomerAdvance {
 organization Organization @relation(fields:[organizationId],references:[id],onDelete:Cascade,onUpdate:NoAction)
 customer Customer @relation(fields:[customerId],references:[id],onDelete:NoAction,onUpdate:NoAction)
 document FinancialDocument @relation(fields:[documentId],references:[id],onDelete:NoAction,onUpdate:NoAction)
 allocations CustomerAdvanceAllocation[]
 refunds CustomerAdvanceRefund[]
 id String @id @default(uuid())
 organizationId String
 customerId String
 documentId String @unique
 amount Decimal @db.Decimal(14,2)
 createdAt DateTime @default(now())
 @@index([organizationId,customerId,createdAt,id],map:"CustomerAdvance_customer_idx")
}
model CustomerAdvanceAllocation {
 advance CustomerAdvance @relation(fields:[advanceId],references:[id],onDelete:Cascade,onUpdate:NoAction)
 debtEntry DebtEntry @relation(fields:[debtEntryId],references:[id],onDelete:NoAction,onUpdate:NoAction)
 id String @id @default(uuid())
 advanceId String
 debtEntryId String @unique
 amount Decimal @db.Decimal(14,2)
 createdAt DateTime @default(now())
 @@index([advanceId],map:"CustomerAdvanceAllocation_advance_idx")
}
model CustomerAdvanceRefund {
 advance CustomerAdvance @relation(fields:[advanceId],references:[id],onDelete:Cascade,onUpdate:NoAction)
 document FinancialDocument @relation(fields:[documentId],references:[id],onDelete:NoAction,onUpdate:NoAction)
 id String @id @default(uuid())
 advanceId String
 documentId String @unique
 amount Decimal @db.Decimal(14,2)
 createdAt DateTime @default(now())
 @@index([advanceId],map:"CustomerAdvanceRefund_advance_idx")
}
