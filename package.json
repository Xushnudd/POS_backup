{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "typecheck": "tsc --noEmit --incremental false",
    "db:migrate": "prisma migrate deploy",
    "test": "node scripts/test.cjs",
    "test:integration": "node scripts/test.cjs --integration",
    "test:e2e": "playwright test",
    "worker:build": "tsc -p tsconfig.worker.json",
    "worker:reconcile": "node --require ./scripts/worker-resolver.cjs .worker-build/scripts/workers/reconcile.js",
    "prebuild": "node scripts/build-offline.cjs",
    "worker:jobs": "node --require ./scripts/worker-resolver.cjs .worker-build/scripts/workers/jobs.js",
    "security:scan": "node scripts/security/scan.mjs",
    "security:scan:test": "node --test scripts/security/scan.test.mjs"
  },
  "dependencies": {
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/free-regular-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@prisma/client": "^5.22.0",
    "@zxing/browser": "^0.2.1",
    "bcryptjs": "^3.0.3",
    "bwip-js": "^4.11.4",
    "exceljs": "4.4.0",
    "jsonwebtoken": "^9.0.3",
    "next": "16.3.8",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "0.35.5",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "prisma": "^5.22.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
